# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env*
!.env.example

# Editors / OS
.DS_Store
.idea/
.vscode/

# Datasets — NEVER commit a frame or a video
data/raw/
data/proprietary/
data/manifests/*.jsonl
